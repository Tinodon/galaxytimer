# Token du bot : https://discord.com/developers/applications > ton app > Bot > Reset Token
DISCORD_TOKEN=
# Application ID : meme page, onglet "General Information" > Application ID
CLIENT_ID=
# OPTIONNEL. Le bot enregistre ses commandes tout seul sur chaque serveur ou on
# l'invite : ce champ n'est plus necessaire au fonctionnement normal.
# Il ne sert qu'aux scripts manuels (`npm run deploy`, `npm run whereami`).
# ID(s) de SERVEUR (clic droit sur l'icone > Copier l'identifiant), separes par
# des virgules — pas l'ID de l'application, c'est le piege classique.
GUILD_ID=

# --- Production uniquement (Render) ---
# Sans ces deux variables, le bot stocke ses timers dans data/timers.json.
# C'est parfait en local, mais le disque de Render est EPHEMERE : il est efface
# a chaque redeploiement, donc un timer Helmet de 35h y serait perdu.
# Les deux valeurs se copient depuis la base Upstash (console.upstash.com),
# onglet REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
